# ============================================================
# vubaokhanh.tech — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Get from: https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Google Analytics 4 (optional) ─────────────────────────
# Get from: https://analytics.google.com → Admin → Data Streams → Measurement ID
# Leave empty to disable analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google Search Console Verification (optional) ─────────
# Get from: https://search.google.com/search-console → Add property → HTML tag method
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code-here

# ── Contact Form Email (optional) ─────────────────────────
# Email address to receive contact form submissions
CONTACT_EMAIL=vubaokhanh2311@gmail.com

# ── Resend Email API (optional) ───────────────────────────
# For actually sending contact form emails. Free: 3,000 emails/month
# Get from: https://resend.com → API Keys
# If not set, form submissions are only logged to the server console.
RESEND_API_KEY=re_your_api_key_here
